{
  "name": "@hibenji/dsh-docker-workspace",
  "version": "0.1.0",
  "description": "Isolated per-session Docker workspaces for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./install-preset": "./dist/install-preset.js",
    "./docker-workspace": "./dist/docker-workspace.js",
    "./docker-fs": "./dist/docker-fs.js",
    "./docker-subprocess": "./dist/docker-subprocess.js"
  },
  "files": [
    "dist/**",
    "docker/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:docker": "DSH_DOCKER_SMOKE=1 node --test --experimental-strip-types tests/docker-smoke.test.ts",
    "check": "npm run verify:syntax && npm test && npm run build",
    "verify:syntax": "find src tests -name '*.ts' -print0 | xargs -0 -n1 node --experimental-strip-types --check",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2 || >=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-agent-presets": "^0.1.1-rc.2 || >=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-fs": "^0.1.1-rc.2 || >=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-fs-local": "^0.1.1-rc.2 || >=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-subprocess": "^0.1.1-rc.2 || >=0.1.2-alpha.1 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hibenji/dsh-docker-workspace.git"
  },
  "homepage": "https://github.com/hibenji/dsh-docker-workspace#readme",
  "bugs": {
    "url": "https://github.com/hibenji/dsh-docker-workspace/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "docker",
    "coding-agent",
    "sandbox",
    "workspace-isolation"
  ]
}
